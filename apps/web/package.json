    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/testing": "^2.2.31",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.11"
  }
