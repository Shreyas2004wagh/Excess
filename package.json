{
  "name": "excess",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @excess/web test:e2e",
    "test:load": "k6 run ops/load/api.js",
    "test:release": "node --test ops/release/*.test.mjs",
    "test:backup": "node --test ops/backup/*.test.mjs",
    "test:backup:integration": "node --test ops/backup/recovery.integration.mjs",
    "test:monitor": "node --test ops/monitor/*.test.mjs",
    "monitor:check": "node ops/monitor/cli.mjs",
    "backup:create": "node ops/backup/cli.mjs create",
    "backup:drill": "node ops/backup/cli.mjs drill",
    "typecheck": "turbo run typecheck",
    "typecheck:deployment": "tsc --noEmit -p .railway/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @excess/database db:generate",
    "db:deploy": "pnpm --filter @excess/database db:deploy",
    "db:migrate": "pnpm --filter @excess/database db:migrate",
    "db:push": "pnpm --filter @excess/database db:push"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "railway": "^3.11.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.42.0"
  }
}
