{
  "name": "@excess/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "vitest": "^4.1.11"
  }
}
