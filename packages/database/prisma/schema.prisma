generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  TRADER
  ADMIN
}

enum AccountType {
  DEMO
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  CLOSED
}

enum InstrumentStatus {
  ACTIVE
  HALTED
  DISABLED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum OrderPurpose {
  ENTRY
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
}

enum LedgerEntryType {
  DEMO_CREDIT
  REALIZED_PNL
  FEE
  ADJUSTMENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum EmailDeliveryStatus {
  DISABLED
  PENDING
  SENT
  FAILED
}

enum PriceAlertDirection {
  ABOVE
  BELOW
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  clerkId           String         @unique
  email             String
  displayName       String?
  status            UserStatus     @default(ACTIVE)
  role              UserRole       @default(TRADER)
  identityDeletedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  accounts          Account[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  priceAlerts       PriceAlert[]

  @@index([email])
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  type           AccountType   @default(DEMO)
  baseCurrency   String        @default("USD")
  balance        Decimal       @default(0) @db.Decimal(28, 10)
  initialBalance Decimal       @default(0) @db.Decimal(28, 10)
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  ledgerEntries  LedgerEntry[]
  orders         Order[]
  positions      Position[]
  trades         Trade[]

  @@unique([userId, type, baseCurrency])
  @@index([userId])
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  accountId      String          @db.Uuid
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(28, 10)
  balanceAfter   Decimal         @db.Decimal(28, 10)
  referenceType  String?
  referenceId    String?
  idempotencyKey String?         @unique
  metadata       Json?
  createdAt      DateTime        @default(now())
  account        Account         @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

model Instrument {
  id                String           @id @default(uuid()) @db.Uuid
  symbol            String           @unique
  baseCurrency      String
  quoteCurrency     String
  pricePrecision    Int
  quantityPrecision Int
  tickSize          Decimal          @db.Decimal(28, 10)
  lotSize           Decimal          @db.Decimal(28, 10)
  minimumQuantity   Decimal          @db.Decimal(28, 10)
  defaultSpreadBps  Decimal          @default(0) @db.Decimal(12, 6)
  status            InstrumentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orders            Order[]
  positions         Position[]
  trades            Trade[]
  priceAlerts       PriceAlert[]
}

model PriceAlert {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  instrumentId   String              @db.Uuid
  direction      PriceAlertDirection
  targetPrice    Decimal             @db.Decimal(28, 10)
  status         PriceAlertStatus    @default(ACTIVE)
  triggeredPrice Decimal?            @db.Decimal(28, 10)
  triggeredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id])
  instrument     Instrument          @relation(fields: [instrumentId], references: [id])

  @@index([userId, status, createdAt])
  @@index([instrumentId, status, targetPrice])
}

model Order {
  id               String       @id @default(uuid()) @db.Uuid
  accountId        String       @db.Uuid
  instrumentId     String       @db.Uuid
  clientOrderId    String
  side             OrderSide
  type             OrderType
  quantity         Decimal      @db.Decimal(28, 10)
  leverage         Decimal      @default(1) @db.Decimal(12, 4)
  requestedPrice   Decimal?     @db.Decimal(28, 10)
  stopPrice        Decimal?     @db.Decimal(28, 10)
  stopLossPrice    Decimal?     @db.Decimal(28, 10)
  takeProfitPrice  Decimal?     @db.Decimal(28, 10)
  executedQuantity Decimal      @default(0) @db.Decimal(28, 10)
  averageFillPrice Decimal?     @db.Decimal(28, 10)
  status           OrderStatus  @default(PENDING)
  purpose          OrderPurpose @default(ENTRY)
  reduceOnly       Boolean      @default(false)
  parentOrderId    String?      @db.Uuid
  ocoGroupId       String?      @db.Uuid
  triggeredAt      DateTime?
  rejectionCode    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  account          Account      @relation(fields: [accountId], references: [id])
  instrument       Instrument   @relation(fields: [instrumentId], references: [id])
  trades           Trade[]
  parentOrder      Order?       @relation("AttachedOrders", fields: [parentOrderId], references: [id])
  attachedOrders   Order[]      @relation("AttachedOrders")

  @@unique([accountId, clientOrderId])
  @@index([accountId, createdAt])
  @@index([accountId, status])
  @@index([instrumentId, status])
  @@index([parentOrderId])
  @@index([ocoGroupId])
}

model Trade {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @db.Uuid
  accountId    String     @db.Uuid
  instrumentId String     @db.Uuid
  positionId   String?    @db.Uuid
  side         OrderSide
  price        Decimal    @db.Decimal(28, 10)
  quantity     Decimal    @db.Decimal(28, 10)
  fee          Decimal    @default(0) @db.Decimal(28, 10)
  spreadBps    Decimal    @default(0) @db.Decimal(12, 6)
  slippageBps  Decimal    @default(0) @db.Decimal(12, 6)
  executedAt   DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  account      Account    @relation(fields: [accountId], references: [id])
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  position     Position?  @relation(fields: [positionId], references: [id])

  @@index([accountId, executedAt])
  @@index([orderId])
}

model Position {
  id                String     @id @default(uuid()) @db.Uuid
  accountId         String     @db.Uuid
  instrumentId      String     @db.Uuid
  signedQuantity    Decimal    @default(0) @db.Decimal(28, 10)
  averageEntryPrice Decimal?   @db.Decimal(28, 10)
  realizedPnl       Decimal    @default(0) @db.Decimal(28, 10)
  leverage          Decimal    @default(1) @db.Decimal(12, 4)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  account           Account    @relation(fields: [accountId], references: [id])
  instrument        Instrument @relation(fields: [instrumentId], references: [id])
  trades            Trade[]

  @@unique([accountId, instrumentId])
  @@index([accountId])
}

model OutboxEvent {
  id            String        @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus  @default(PENDING)
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  claimedAt     DateTime?
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  notification  Notification?

  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  outboxEventId     String              @unique @db.Uuid
  type              String
  title             String
  message           String
  metadata          Json?
  readAt            DateTime?
  emailStatus       EmailDeliveryStatus @default(DISABLED)
  emailAttempts     Int                 @default(0)
  emailProviderId   String?
  emailLastError    String?
  emailSentAt       DateTime?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id])
  outboxEvent       OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt, id])
  @@index([action, createdAt, id])
}
